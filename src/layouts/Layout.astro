---
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
	<html lang="en" data-theme="emerald">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Randy Yang | Data Engineering Manager" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
		<link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
		<script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
			integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-base-200 text-base-content">
		<slot />
	</body>
</html>

<script is:inline>
	const theme = (() => {
		const savedTheme = localStorage.getItem("theme");

		if (savedTheme === "forest" || savedTheme === "dark") {
			return "forest";
		}
		if (savedTheme === "emerald" || savedTheme === "light") {
			return "emerald";
		}

		return window.matchMedia("(prefers-color-scheme: dark)").matches ? "forest" : "emerald";
	})();

	document.documentElement.classList.toggle("dark", theme === "forest");
	document.documentElement.setAttribute("data-theme", theme);
	window.localStorage.setItem("theme", theme);
</script>
