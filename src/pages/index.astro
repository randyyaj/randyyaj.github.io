			},
		]
	}
];
---

<Layout title="Randy Yang">
	<main class="min-h-screen">
		<nav class="sticky top-0 z-20 border-b border-base-300 bg-base-100/95 backdrop-blur" aria-label="Main navigation">
			<div class="navbar mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="flex-1">
					<a href="/" class="btn btn-ghost px-2 text-lg font-bold">Randy Yang</a>
				</div>
				<div class="hidden items-center gap-1 sm:flex">
					<a href="#experience" class="btn btn-ghost btn-sm">Experience</a>
					<a href="#professional-projects" class="btn btn-ghost btn-sm">Projects</a>
					<a href="#contact" class="btn btn-ghost btn-sm">Contact</a>
				</div>
				<div class="dropdown dropdown-end sm:hidden">
					<button tabindex="0" class="btn btn-ghost btn-circle" aria-label="Open navigation menu">
						<i class="fa-solid fa-bars" aria-hidden="true"></i>
					</button>
					<ul tabindex="0" class="menu dropdown-content z-30 mt-3 w-44 rounded-box border border-base-300 bg-base-100 p-2 shadow">
						<li><a href="#experience">Experience</a></li>
						<li><a href="#professional-projects">Projects</a></li>
						<li><a href="#contact">Contact</a></li>
					</ul>
				</div>
				<button id="themeSwitchButton" type="button" class="btn btn-ghost btn-circle" aria-label="Toggle color theme" title="Toggle color theme">
					<i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i>
				</button>
			</div>
		</nav>

		<div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
			<header class="grid gap-10 border-b border-base-300 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-center">
				<div class="max-w-3xl">
					<p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary">Data Engineering Manager</p>
					<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Building reliable systems from complex data.</h1>
					<p class="mt-6 text-lg leading-8 text-base-content/75">
						Data Engineering Manager with 13+ years of experience designing and delivering scalable data platforms, ETL pipelines, and cloud-native applications. Proven track record leading engineering teams, building event-driven architectures on AWS, and partnering with business stakeholders to transform complex data into actionable insights.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a class="btn btn-primary" href="#experience">View experience</a>
						<a class="btn btn-outline" href="/resume/Randy_Yang_Resume.docx" download>Download resume</a>
					</div>
				</div>
				<aside class="card border border-base-300 bg-base-100 shadow-sm">
					<div class="card-body p-5">
						<h2 class="card-title text-base">At a glance</h2>
						<div class="divider my-0"></div>
						<dl class="space-y-4 text-sm">
							<div>
								<dt class="text-base-content/60">Based in</dt>
								<dd class="font-medium">Spartanburg, South Carolina</dd>
							</div>
							<div>
								<dt class="text-base-content/60">Focus</dt>
								<dd class="font-medium">Data platforms, cloud architecture, engineering leadership</dd>
							</div>
							<div>
								<dt class="text-base-content/60">Experience</dt>
								<dd class="font-medium">13+ years</dd>
							</div>
						</dl>
					</div>
				</aside>
			</header>

			<section id="experience" class="scroll-mt-24 border-b border-base-300 py-14 sm:py-16">
				<div class="mb-8 flex items-end justify-between gap-4">
					<div>
						<p class="text-sm font-semibold uppercase tracking-widest text-primary">Career</p>
						<h2 class="mt-2 text-3xl font-bold tracking-tight">Experience</h2>
					</div>
					<a href="#experience" class="link link-hover hidden text-sm sm:inline">Permalink</a>
				</div>
				<div class="space-y-5">
					{
						experiences.map((experience: Experience) => (
							<article class="card border border-base-300 bg-base-100 shadow-sm">
								<div class="card-body gap-5 p-5 sm:p-6">
									<div class="flex flex-col gap-2 border-b border-base-300 pb-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
										<div>
											<h3 class="card-title text-xl">{experience.position}</h3>
											<p class="mt-1 font-medium text-base-content/75">{experience.workplace}</p>
										</div>
										<div class="text-sm text-base-content/65 sm:text-right">
											<p>{experience.serviceLength}</p>
											<p>{experience.location}</p>
										</div>
									</div>
									<ul class="list-disc space-y-2 pl-5 text-sm leading-6 text-base-content/80">
										{
											experience.description.map((description: Description) => (
												<li>
													{description.text}
													{description.subtext && (
														<ul class="mt-2 list-[circle] space-y-1 pl-5">
															{description.subtext.map((subtext: Description) => <li>{subtext.text}</li>)}
														</ul>
													)}
												</li>
											))
										}
									</ul>
									{experience.techstack.length > 0 && (
										<details class="collapse collapse-arrow rounded-box border border-base-300 bg-base-200">
											<summary class="collapse-title min-h-0 py-3 font-medium">Technology used</summary>
											<div class="collapse-content">
												<div class="flex flex-wrap gap-2 pt-1">
													{experience.techstack.map((technology: Technology) => (
														<a class="badge badge-outline transition-colors hover:badge-primary" href={technology.url} target="_blank" rel="noreferrer">{technology.name}</a>
													))}
												</div>
											</div>
										</details>
									)}
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section id="professional-projects" class="scroll-mt-24 border-b border-base-300 py-14 sm:py-16">
				<div class="mb-8 flex items-end justify-between gap-4">
					<div>
						<p class="text-sm font-semibold uppercase tracking-widest text-primary">Selected work</p>
						<h2 class="mt-2 text-3xl font-bold tracking-tight">Professional Projects</h2>
					</div>
					<a href="#professional-projects" class="link link-hover hidden text-sm sm:inline">Permalink</a>
				</div>
				<div class="grid gap-5 md:grid-cols-2">
					{projects.map((project: Project) => (
						<article class="card border border-base-300 bg-base-100 shadow-sm">
							<div class="card-body gap-3 p-5">
								<h3 class="card-title text-lg">{project.title}</h3>
								<div class="text-sm leading-6 text-base-content/75">
									{project.description.map((description: Description) => <p>{description.text}</p>)}
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<section id="personal-projects" class="scroll-mt-24 border-b border-base-300 py-14 sm:py-16">
				<div class="mb-8 flex items-end justify-between gap-4">
					<div>
						<p class="text-sm font-semibold uppercase tracking-widest text-primary">Outside of work</p>
						<h2 class="mt-2 text-3xl font-bold tracking-tight">Personal Projects</h2>
					</div>
					<a href="#personal-projects" class="link link-hover hidden text-sm sm:inline">Permalink</a>
				</div>
				<div class="grid gap-5 md:grid-cols-2">
					<a href="https://github.com/randyyaj/" target="_blank" rel="noreferrer" class="card border border-dashed border-base-300 bg-base-100 shadow-sm transition-colors hover:border-primary">
						<div class="card-body flex-row items-center gap-4 p-5">
							<i class="fa-brands fa-github text-2xl" aria-hidden="true"></i>
							<div>
								<h3 class="font-semibold">Github</h3>
								<p class="text-sm text-base-content/65">View all repositories</p>
							</div>
						</div>
					</a>
					{personalProjects.map((project: Project) => (
						<article class="card border border-base-300 bg-base-100 shadow-sm">
							<div class="card-body gap-3 p-5">
								{project.url ? (
									<a href={project.url} target="_blank" rel="noreferrer" class="link link-hover card-title text-lg">{project.title} <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i></a>
								) : <h3 class="card-title text-lg">{project.title}</h3>}
								<div class="text-sm leading-6 text-base-content/75">
									{project.description.map((description: Description) => <p>{description.text}</p>)}
								</div>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="grid gap-10 border-b border-base-300 py-14 sm:py-16 md:grid-cols-2">
				<div id="resume" class="scroll-mt-24">
					<p class="text-sm font-semibold uppercase tracking-widest text-primary">Background</p>
					<h2 class="mt-2 text-3xl font-bold tracking-tight">Resume</h2>
					<p class="mt-4 max-w-md text-base-content/75">Download a copy of my resume for a concise overview of my experience and technical background.</p>
					<a class="btn btn-primary mt-6 w-fit" href="/resume/Randy_Yang_Resume.docx" download><i class="fa-solid fa-file-arrow-down mr-2" aria-hidden="true"></i>Download resume</a>
				</div>
